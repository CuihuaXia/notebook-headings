{
  // Press F5 to start an Extension Development Host with this extension
  // loaded from source and the sample files opened as the workspace.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/examples"]
    },
    {
      // For README screenshots: other installed extensions are turned off so
      // their decorations and status bar items stay out of the picture.
      "name": "Screenshots (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/examples",
        "${workspaceFolder}/examples/showcase.ipynb"
      ]
    }
  ]
}
