{
  "name": "notebook-headings",
  "displayName": "Notebook Headings",
  "description": "%extension.description%",
  "version": "1.6.0",
  "publisher": "cuihuaxia",
  "author": {
    "name": "Cuihua Xia"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CuihuaXia/notebook-headings.git"
  },
  "homepage": "https://github.com/CuihuaXia/notebook-headings#readme",
  "bugs": {
    "url": "https://github.com/CuihuaXia/notebook-headings/issues"
  },
  "icon": "media/icon.png",
  "keywords": [
    "jupyter",
    "notebook",
    "markdown",
    "outline",
    "headings",
    "table of contents",
    "toc",
    "myst",
    "todo",
    "bookmarks"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onNotebook:jupyter-notebook",
    "onLanguage:markdown"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/integration/run.js",
    "package": "npx -y @vscode/vsce package -o releases/",
    "install-local": "npm run package && code --install-extension releases/notebook-headings-$npm_package_version.vsix",
    "icons": "node scripts/status-icons.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "notebookHeadings",
          "title": "Notebook Headings",
          "icon": "media/headings.svg"
        }
      ]
    },
    "views": {
      "notebookHeadings": [
        {
          "id": "notebookHeadings.view",
          "name": "Notebook Headings",
          "icon": "media/headings.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "notebookHeadings.view",
        "contents": "%view.welcome%"
      }
    ],
    "commands": [
      {
        "command": "notebookHeadings.quickJump",
        "title": "%command.quickJump%",
        "icon": "$(go-to-search)"
      },
      {
        "command": "notebookHeadings.filter",
        "title": "%command.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "notebookHeadings.clearFilter",
        "title": "%command.clearFilter%",
        "icon": "$(close)"
      },
      {
        "command": "notebookHeadings.toggleNumbering",
        "title": "%command.toggleNumbering%",
        "icon": "$(list-ordered)"
      },
      {
        "command": "notebookHeadings.resetExpansion",
        "title": "%command.resetExpansion%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "notebookHeadings.reveal",
        "title": "%command.reveal%"
      },
      {
        "command": "notebookHeadings.copyTitle",
        "title": "%command.copyTitle%",
        "icon": "$(copy)"
      },
      {
        "command": "notebookHeadings.copyReference",
        "title": "%command.copyReference%"
      },
      {
        "command": "notebookHeadings.selectSection",
        "title": "%command.selectSection%",
        "icon": "$(selection)"
      },
      {
        "command": "notebookHeadings.editCellTags",
        "title": "%command.editCellTags%",
        "icon": "$(tag)"
      },
      {
        "command": "notebookHeadings.editSectionTags",
        "title": "%command.editSectionTags%",
        "icon": "$(tag)"
      },
      {
        "command": "notebookHeadings.setStatus",
        "title": "%command.setStatus%",
        "icon": "$(tasklist)"
      },
      {
        "command": "notebookHeadings.addStar",
        "title": "%command.addStar%",
        "icon": "$(star-empty)"
      },
      {
        "command": "notebookHeadings.removeStar",
        "title": "%command.removeStar%",
        "icon": "$(star-full)"
      },
      {
        "command": "notebookHeadings.showMarked",
        "title": "%command.showMarked%",
        "icon": "$(bookmark)"
      },
      {
        "command": "notebookHeadings.copyContent",
        "title": "%command.copyContent%"
      },
      {
        "command": "notebookHeadings.clearOutputs",
        "title": "%command.clearOutputs%",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "notebookHeadings.filter",
          "when": "view == notebookHeadings.view && !notebookHeadings.filtering",
          "group": "navigation@1"
        },
        {
          "command": "notebookHeadings.clearFilter",
          "when": "view == notebookHeadings.view && notebookHeadings.filtering",
          "group": "navigation@1"
        },
        {
          "command": "notebookHeadings.showMarked",
          "when": "view == notebookHeadings.view && !notebookHeadings.filtering",
          "group": "navigation@2"
        },
        {
          "command": "notebookHeadings.toggleNumbering",
          "when": "view == notebookHeadings.view",
          "group": "navigation@3"
        },
        {
          "command": "notebookHeadings.resetExpansion",
          "when": "view == notebookHeadings.view",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "notebookHeadings.reveal",
          "when": "false"
        },
        {
          "command": "notebookHeadings.clearFilter",
          "when": "notebookHeadings.filtering"
        },
        {
          "command": "notebookHeadings.copyTitle",
          "when": "false"
        },
        {
          "command": "notebookHeadings.copyReference",
          "when": "false"
        },
        {
          "command": "notebookHeadings.selectSection",
          "when": "false"
        },
        {
          "command": "notebookHeadings.editCellTags",
          "when": "notebookType == 'jupyter-notebook'"
        },
        {
          "command": "notebookHeadings.editSectionTags",
          "when": "false"
        },
        {
          "command": "notebookHeadings.setStatus",
          "when": "false"
        },
        {
          "command": "notebookHeadings.addStar",
          "when": "false"
        },
        {
          "command": "notebookHeadings.removeStar",
          "when": "false"
        },
        {
          "command": "notebookHeadings.copyContent",
          "when": "false"
        },
        {
          "command": "notebookHeadings.clearOutputs",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "notebookHeadings.setStatus",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/",
          "group": "0_mark@1"
        },
        {
          "command": "notebookHeadings.addStar",
          "when": "view == notebookHeadings.view && viewItem == heading",
          "group": "0_mark@2"
        },
        {
          "command": "notebookHeadings.removeStar",
          "when": "view == notebookHeadings.view && viewItem == heading.starred",
          "group": "0_mark@2"
        },
        {
          "command": "notebookHeadings.selectSection",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/",
          "group": "0_select@1"
        },
        {
          "command": "notebookHeadings.editSectionTags",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/ && notebookHeadings.isNotebook",
          "group": "0_select@2"
        },
        {
          "command": "notebookHeadings.copyTitle",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/",
          "group": "1_copy@1"
        },
        {
          "command": "notebookHeadings.copyReference",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/",
          "group": "1_copy@2"
        },
        {
          "command": "notebookHeadings.copyContent",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/",
          "group": "1_copy@3"
        },
        {
          "command": "notebookHeadings.clearOutputs",
          "when": "view == notebookHeadings.view && viewItem =~ /^heading/ && notebookHeadings.isNotebook",
          "group": "2_outputs@1"
        }
      ]
    },
    "configuration": {
      "title": "Notebook Headings",
      "properties": {
        "notebookHeadings.defaultExpandLevel": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "%config.defaultExpandLevel%"
        },
        "notebookHeadings.numbering": {
          "type": "boolean",
          "default": true,
          "description": "%config.numbering%"
        },
        "notebookHeadings.numberH1": {
          "type": "boolean",
          "default": false,
          "description": "%config.numberH1%"
        },
        "notebookHeadings.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "%config.followCursor%"
        },
        "notebookHeadings.showCellCount": {
          "type": "boolean",
          "default": true,
          "description": "%config.showCellCount%"
        },
        "notebookHeadings.showOutputSize": {
          "type": "boolean",
          "default": true,
          "description": "%config.showOutputSize%"
        },
        "notebookHeadings.levelColors": {
          "type": "boolean",
          "default": true,
          "description": "%config.levelColors%"
        },
        "notebookHeadings.markdown": {
          "type": "boolean",
          "default": true,
          "description": "%config.markdown%"
        },
        "notebookHeadings.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar%"
        },
        "notebookHeadings.cellTagButton": {
          "type": "boolean",
          "default": true,
          "description": "%config.cellTagButton%"
        },
        "notebookHeadings.inProgressMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "???",
            "？？？"
          ],
          "description": "%config.inProgressMarkers%"
        }
      }
    },
    "keybindings": [
      {
        "command": "notebookHeadings.filter",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "focusedView == notebookHeadings.view"
      },
      {
        "command": "notebookHeadings.quickJump",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "notebookEditorFocused || editorLangId == markdown"
      }
    ],
    "colors": [
      {
        "id": "notebookHeadings.level1Foreground",
        "description": "%color.level1%",
        "defaults": {
          "light": "#DC1D04",
          "dark": "#FF6B4A",
          "highContrast": "#FF6B4A",
          "highContrastLight": "#DC1D04"
        }
      },
      {
        "id": "notebookHeadings.level2Foreground",
        "description": "%color.level2%",
        "defaults": {
          "light": "#F29F05",
          "dark": "#FFC24D",
          "highContrast": "#FFC24D",
          "highContrastLight": "#F29F05"
        }
      },
      {
        "id": "notebookHeadings.level3Foreground",
        "description": "%color.level3%",
        "defaults": {
          "light": "#048ABF",
          "dark": "#4FC3F7",
          "highContrast": "#4FC3F7",
          "highContrastLight": "#048ABF"
        }
      },
      {
        "id": "notebookHeadings.level4Foreground",
        "description": "%color.level4%",
        "defaults": {
          "light": "#5B2A9E",
          "dark": "#B48EE0",
          "highContrast": "#B48EE0",
          "highContrastLight": "#5B2A9E"
        }
      },
      {
        "id": "notebookHeadings.level5Foreground",
        "description": "%color.level5%",
        "defaults": {
          "light": "#A69232",
          "dark": "#D6C55A",
          "highContrast": "#D6C55A",
          "highContrastLight": "#A69232"
        }
      },
      {
        "id": "notebookHeadings.level6Foreground",
        "description": "%color.level6%",
        "defaults": {
          "light": "#B3B3B3",
          "dark": "#8A8A8A",
          "highContrast": "#8A8A8A",
          "highContrastLight": "#B3B3B3"
        }
      }
    ]
  }
}
